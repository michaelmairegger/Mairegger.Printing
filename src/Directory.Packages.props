<Project>
  <Import Project="Versions.props" />
  <PropertyGroup Label="Release line">
    <!-- A release line (version.json without prerelease suffix, e.g. 10.0.15 on release/v10.0) builds and packs only the
         .NET version matching the major in version.json (plus .NET Framework); main (e.g. 11.0.0.0-alpha) builds all
         target frameworks. Override with -p:ReleaseNetMajor=X -->
    <_VersionJsonVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../version.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</_VersionJsonVersion>
    <ReleaseNetMajor Condition="'$(ReleaseNetMajor)' == '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(_VersionJsonVersion)', '^v?\d+(?:\.\d+){1,3}-'))">$([System.Text.RegularExpressions.Regex]::Match('$(_VersionJsonVersion)', '^v?(\d+)').Groups[1].Value)</ReleaseNetMajor>
  </PropertyGroup>
  <PropertyGroup Label="Target Frameworks">
    <NetCoreAppCurrent Condition="'$(CurrentNetVersion)' != ''">net$(CurrentNetVersion.Substring(0,$(CurrentNetVersion.LastIndexOf('.'))))</NetCoreAppCurrent>
    <NetCoreAppPrevious Condition="'$(PreviousNetVersion)' != ''">net$(PreviousNetVersion.Substring(0,$(PreviousNetVersion.LastIndexOf('.'))))</NetCoreAppPrevious>
    <NetCoreAppMinimum Condition="'$(MinimumNetVersion)' != ''">net$(MinimumNetVersion.Substring(0,$(MinimumNetVersion.LastIndexOf('.'))))</NetCoreAppMinimum>
    <!-- release line: keep only the target framework matching ReleaseNetMajor -->
    <NetCoreAppCurrent Condition="'$(ReleaseNetMajor)' != '' and '$(NetCoreAppCurrent)' != 'net$(ReleaseNetMajor).0'"></NetCoreAppCurrent>
    <NetCoreAppPrevious Condition="'$(ReleaseNetMajor)' != '' and '$(NetCoreAppPrevious)' != 'net$(ReleaseNetMajor).0'"></NetCoreAppPrevious>
    <NetCoreAppMinimum Condition="'$(ReleaseNetMajor)' != '' and '$(NetCoreAppMinimum)' != 'net$(ReleaseNetMajor).0'"></NetCoreAppMinimum>
    <NetCoreWpfCurrent Condition="'$(NetCoreAppCurrent)' != ''">$(NetCoreAppCurrent)-windows$(WindowsSdkVersion)</NetCoreWpfCurrent>
    <NetCoreWpfPrevious Condition="'$(NetCoreAppPrevious)' != ''">$(NetCoreAppPrevious)-windows$(WindowsSdkVersion)</NetCoreWpfPrevious>
    <NetCoreWpfMinimum Condition="'$(NetCoreAppMinimum)' != ''">$(NetCoreAppMinimum)-windows$(WindowsSdkVersion)</NetCoreWpfMinimum>

    <TargetNetCoreVersion Condition="'$(NetCoreAppCurrent)' != '' and $(TargetFramework.StartsWith($(NetCoreAppCurrent)))">$(CurrentNetVersion)</TargetNetCoreVersion>
    <TargetNetCoreVersion Condition="'$(NetCoreAppPrevious)' != '' and $(TargetFramework.StartsWith($(NetCoreAppPrevious)))">$(PreviousNetVersion)</TargetNetCoreVersion>
    <TargetNetCoreVersion Condition="'$(NetCoreAppMinimum)' != '' and $(TargetFramework.StartsWith($(NetCoreAppMinimum)))">$(MinimumNetVersion)</TargetNetCoreVersion>
  </PropertyGroup>
  <PropertyGroup Label="Set WPF properties">
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <PropertyGroup Label="NuGet settings">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <EnablePackageVersionOverride>false</EnablePackageVersionOverride>

    <WarningsAsErrors Label="Duplicate 'PackageReference' items found">$(WarningsAsErrors);NU1504</WarningsAsErrors>
    <WarningsAsErrors Label="Duplicate 'PackageDownload' items found">$(WarningsAsErrors);NU1505</WarningsAsErrors>
    <WarningsAsErrors Label="Duplicate 'PackageVersion' items found">$(WarningsAsErrors);NU1506</WarningsAsErrors>
    <WarningsAsErrors Label="There are 2 package sources defined in your configuration">$(WarningsAsErrors);NU1507</WarningsAsErrors>

    <WarningsAsErrors Label="Package X has a known low severity vulnerability">$(WarningsAsErrors);NU1901</WarningsAsErrors>
    <WarningsAsErrors Label="Package X has a known moderate severity vulnerability">$(WarningsAsErrors);NU1902</WarningsAsErrors>
    <WarningsAsErrors Label="Package X has a known high severity vulnerability">$(WarningsAsErrors);NU1903</WarningsAsErrors>
    <WarningsAsErrors Label="Package X has a known critical severity vulnerability">$(WarningsAsErrors);NU1904</WarningsAsErrors>
    <WarningsAsErrors Label="'PackageA' 4.0.0 depends on 'PackageB' (>= 4.0.0) but 4.0.0 was not found. An approximate best match of 5.0.0 was resolved.">$(WarningsAsErrors);NU1603</WarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Label="Source commit tagging" Condition="'$(Configuration)' != 'Release'">
    <!-- Note: This prevents rebuilding all projects because of a commit, since build steps injects version information into projects. -->
    <NBGV_GitEngine>Disabled</NBGV_GitEngine>
    <EnableSourceLink>false</EnableSourceLink>
    <!-- prevents generation of $(ProjectName).sourcelink.json -->
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" Version="$(NerdbankGitVersioningVersion)" />
    <GlobalPackageReference Include="WpfAnalyzers" Condition="'$(UseWpf)' == 'true'" Version="$(WpfAnalyzersVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Bogus" Version="$(BogusVersion)" />
    <PackageVersion Include="Enums.NET" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="TUnit" Version="$(TUnitVersion)" />
    <PackageVersion Include="TUnit.Mocks" Version="$(TUnitVersion)" />
  </ItemGroup>
</Project>
