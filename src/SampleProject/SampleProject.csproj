<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(NetCoreWpfCurrent);$(NetCoreWpfPrevious);$(NetCoreWpfMinimum);$(NetFrameworkMinimum)</TargetFrameworks>

    <OutputType>WinExe</OutputType>
    <RootNamespace>Mairegger.Printing.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="Workaround for parallel WPF markup compilation with UseArtifactsOutput">
    <!--
      For XAML that references local types WPF builds a temporary *_wpftmp project and strips the TargetFramework from the end of
      the IntermediateOutputPath (Microsoft.WinFX.targets). With the default artifacts pivot "<configuration>_<targetframework>"
      this results in ".../obj/SampleProject/release_/" for all target frameworks, which breaks parallel builds (MC2000, CS2012).
      Putting the target framework first keeps a separate intermediate output path per target framework.
    -->
    <ArtifactsPivots Condition="'$(TargetFramework)' != ''">$(TargetFramework.ToLowerInvariant())_$(Configuration.ToLowerInvariant())</ArtifactsPivots>
  </PropertyGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <Reference Include="ReachFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mairegger.Printing\Mairegger.Printing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
